# Copy to remote/hosts.env (gitignored) and fill in the servers the remote
# chain sets up. Any value can also be passed as an environment variable of
# the same name, which takes precedence over this file; REMOTE_HOSTS_FILE
# points the chain at a different file.
#
# Each server: a fresh Ubuntu 24.04 install (any provider), reachable over
# ssh as SSH_USER, who needs passwordless sudo and bash as login shell (the
# default for cloud images' ubuntu user).
#
# Ports (restrict to your own address wherever the firewall allows):
#   control plane, from this machine: 22, 80, 3000 (Dokploy), 5000
#     (registry), 8200 (OpenBao) - the chain talks to all of them
#     directly, over plain HTTP
#   control plane, from the internet: 80/443, for the apps behind Traefik
#   between all nodes: 2377/tcp, 7946/tcp+udp, 4789/udp (Docker Swarm)
#   workers, from this machine: 22

# Public (or otherwise reachable-from-here) IPv4 address of the control plane.
CP_HOST="203.0.113.10"
# Space-separated IPv4 addresses of the workers, in order; may be empty.
WORKER_HOSTS="203.0.113.11 203.0.113.12"

# Address the workers reach the control plane on. Defaults to the control
# plane's own primary address, which is right both for hosts with a public
# IP on their interface and for clouds that NAT one onto a private network.
# CP_SWARM_ADDR="10.0.0.10"

SSH_USER="ubuntu"
# SSH_PORT="22"
# Defaults to your ssh agent / ~/.ssh/config.
# SSH_KEY="~/.ssh/id_ed25519"
