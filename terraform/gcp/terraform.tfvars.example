# Copy to terraform.tfvars (gitignored) and fill in. Everything else has a
# default in variables.tf that can be overridden here too.
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# sammosios.com's zone id (dashboard > the zone > Overview), and a token
# with Zone > DNS > Edit on it.
cloudflare_zone_id   = "0123456789abcdef0123456789abcdef"
cloudflare_api_token = "REPLACE_ME"

# Dokploy's first admin; its password is generated
# (terraform output -raw dokploy_admin_password).
dokploy_admin_name  = "Your Name"
dokploy_admin_email = "you@example.com"

# zone              = "europe-north1-b"  # if europe-north1-a is out of capacity
# ssh_source_ranges = ["198.51.100.7/32"]
