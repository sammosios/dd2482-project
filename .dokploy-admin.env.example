# Copy to .dokploy-admin.env (gitignored) and fill in real values to let
# 01-dokploy-api-key.sh provision the first admin account and API key
# automatically instead of printing manual browser instructions.
DOKPLOY_ADMIN_NAME="Admin"
DOKPLOY_ADMIN_EMAIL="admin@dokploy.local"
DOKPLOY_ADMIN_PASSWORD="change-me-to-something-real"
