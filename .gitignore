# Terraform: provider caches, the variable files that hold tokens, and state
# (only terraform/bootstrap keeps a local one; the other stages keep theirs
# in the GCS bucket it creates).
terraform/**/.terraform/
terraform/**/terraform.tfvars
terraform/**/*.tfstate
terraform/**/*.tfstate.*
# Credentials files and state of the old script chain, which may still be on
# a machine that ran it.
.dokploy-admin.env
.github-runner.env
.state/
local/forward.sh
# Python bytecode.
__pycache__/
